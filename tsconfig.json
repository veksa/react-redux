{
  // For general development and intellisense.
  // Scans the entire source code against the current TS version
  // we are using during development.
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "rootDir": "."
  },
  "include": ["."],
  // The benchmark scripts are plain `.mjs`; with `allowJs`/`checkJs` they would
  // otherwise be pulled into type-checking.
  "exclude": ["dist*", "examples", "docs", "benchmark"]
}
